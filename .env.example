# Kopiere diese Datei nach .env.local und trage deine Werte ein.
# Alle Werte werden zur Laufzeit gelesen – ein Build/Docker-Image passt für jeden Tenant.

# Azure / Entra ID App-Registrierung (Plattform „Single-page application“)
# Redirect-URI: http://localhost:3000/auth/redirect
AZURE_CLIENT_ID=
# Verzeichnis-(Tenant-)ID – leer lassen für Multi-Tenant („organizations“)
AZURE_TENANT_ID=

# KI-Anbieter – mindestens einer, beide gleichzeitig möglich (Auswahl dann in der App)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Bevorzugter Anbieter, wenn beide konfiguriert sind: openai | gemini
AI_PROVIDER=
